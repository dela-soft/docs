      ["n",   "я",    "і",    "і",    "ю",    "ёй",   "і",    "лы"],                 // Бухгалтеры-я   
      ["n",   "я",    "і",    "і",    "ю",    "яй",   "і",    "н"],                  // Фотамайстэрн-я   
      ["n",   "",     "а",    "у",    "",     "ам",   "е",    "лм"],                 // Аддзел, Дом  
      ["n",   "",     "а",    "у",    "а",    "ам",   "у",    "гкрт"],               // …

      ["a",   "ае",   "ага",  "аму",  "ым",   "ым",   "ым",   "н"],                  // Галоўн-ае
      ["a",   "ая",   "ай",   "ай",   "ую",   "ай",   "ай",   "нч"],                 // Дзяржаўн-ая
      ["a",   "ы",    "ага",  "аму",  "ага",  "ым",   "ым",   "внрш"],               // Навуков-ы   
