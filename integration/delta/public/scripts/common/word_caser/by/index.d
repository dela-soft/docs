      ["2f",  "га",   "гі",   "зе",   "гу",   "гай",  "зе",   ""],                   // Воль-га
      ["2f",  "ка",   "кі",   "цы",   "ку",   "кай",  "ке",   ""],                   // Анжэлі-ка
      ["2f",  "та",   "ты",   "це",   "ту",   "тай",  "це",   ""],                   // * Лізаве-та
      ["2f",  "а",    "ы",    "ы",    "у",    "ай",   "ы",    "р"],                  // Аляксандр-а
      ["2f",  "а",    "ы",    "зе",   "у",    "ай",   "зе",   "д"],                  // Зінаід-а
      ["2f",  "а",    "ы",    "е",    "у",    "ай",   "е",    "влнс"],               // Ев-а, Ін-а, Людміл-а, Тэрэса
      ["2f",  "я",    "і",    "і",    "ю",    "яй",   "і",    ""],                   // Леакадзі-а
      ["2f",  "ў",    "ві",   "ві",   "ў",    "ўю",   "ві",   ""],                   // Любо-ў
      // Отчество
