      ["...", "ая",   "ую",   "ай",   "ую",   "ай",   "ай",                          // Одушевленное существітельное Прыемн-ая маці
                                                              ["прыёмная"] ],       
                                                                         
      // Post (#n / #a)
      ["#n",  "вец",  "ўца",  "ўцу",  "ўца",  "ўцам", "ўцу",  ""],                   // Таваразна-вец   
      ["#n",  "а",    "і",    "у",    "у",    "ам",   "у",    "к"],                  // Бацьк-а 
      ["#n",  "а",    "ы",    "е",    "у",    "ай",   "е",    "впб"],                // Установ-а, Груп-а   
      ["#n",  "а",    "ы",    "ы",    "у",    "ай",   "ы",    "ц"],                  // Прыбіральшчыц-а   
      ["#n",  "е",    "я",    "ю",    "і",    "ем",   "і",    "н"],                  // Упраўленн-е 
      ["#n",  "ь",    "я",    "ю",    "я",    "ем",   "ю",    "лн"],                 // Вадзіцел-ь  
      ["#n",  "ы",    "ага",  "аму",  "ага",  "ым",   "ым",   "ч"],                  // Рабоч-ы   
      ["#n",  "я",    "і",    "і",    "ю",    "ёй",   "і",    "лы"],                 // Бухгалтеры-я   
      ["#n",  "я",    "і",    "і",    "ю",    "яй",   "і",    "н"],                  // Фотамайстэрн-я   
      ["#n",  "",     "а",    "у",    "",     "ам",   "е",    "лм"],                 // Аддзел, Дом  
      ["#n",  "",     "а",    "у",    "а",    "ам",   "у",    "гкрт"],               // Тэхнолаг, Загадчык, Бухгалтар, Спецыяліст  

      ["#a",  "ае",   "ага",  "аму",  "ым",   "ым",   "ым",   "н"],                  // Галоўн-ае
      ["#a",  "ая",   "ай",   "ай",   "ую",   "ай",   "ай",   "нч"],                 // Дзяржаўн-ая, Гаспадарч-ая
      ["#a",  "ы",    "ага",  "аму",  "ага",  "ым",   "ым",   "внрш"],               // Галоўн-ы, Малодш-ы, Навуков-ы   
      ["#a",  "і",    "ага",  "аму",  "і",    "ім",   "ім",   "к"],                  // Выдавецк-і   

      // Агульныя (падраздзяленне, установа, …) — С / П
