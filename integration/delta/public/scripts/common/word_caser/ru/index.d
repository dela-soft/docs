include "../engine.d"

/** Правила склонения для русского языка. */
class WordCaserEngineRu : WordCaserEngine
{
  /// Суффиксы, которые в PostCase не склоняем (готовые / не-личные формы)
  static List PostExceptionEnds => ["ого", "ция", "сия"];

  /// Окончания прилагательных
  static List AdjectiveEnds => ["ая", "ое", "ый", "ий"];

  bool IsPostExceptionWord(string word)
  {
    word = word.ToLower();
    if (PostExceptionEnds.Any(s => word.EndsWith(s)))
      return true;
    return base.IsPostExceptionWord(word);
  }

  string GetWordForm(string word)
  {
    word = word.ToLower();
    if (AdjectiveEnds.Any(s => word.EndsWith(s)))
      return "a";
    return base.GetWordForm(word);
  }

  WordCaserEngineRu() : base()
  {
    _prepositions =
    [
      "по", "с", "со", "в", "во", "на", "о", "об", "обо",
      "от", "до", "для", "к", "ко", "у", "при", "без",
      "над", "под", "перед", "через",
    ];
    _cases = 
    [
      // Фамилия
      ["1m",  "ан",   "ана",  "ану",  "ана",  "аном", "ане",  ""],                   // Лам-ан
      ["1m",  "ец",   "ца",   "цу",   "ца",   "цом",  "це",   ""],                   // Лукьян-ец
      ["1m",  "ей",   "ея",   "ею",   "ея",   "еем",  "ее",   ""],                   // Каз-ей
      ["1m",  "ий",   "ого",  "ому",  "ого",  "им",   "ом",   ""],                   // Дольск-ий
      ["1m",  "их",   "ого",  "ому",  "ого",  "им",   "ом",   ""],                   // Коротк-их
      ["1m",  "ой",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Рогов-ой
      ["1m",  "а",    "ы",    "е",    "у",    "ой",   "е",    ""],                   // Яцын-а
      ["1m",  "в",    "ва",   "ву",   "ва",   "вым",  "ве",   ""],                   // Босалае-в
      ["1m",  "ь",    "я",    "ю",    "я",    "ем",   "е",    ""],                   // Черван-ь
      ["1m",  "",     "а",    "у",    "а",    "ом",   "е",    "крс"],                // Вознячук
      ["1m",  "",     "а",    "у",    "а",    "ем",   "е",    "цч"],                 // Гриц, Жданович
      ["1m",  "",     "а",    "у",    "а",    "ым",   "е",    "н"],                  // Ермохин

      ["1f",  "ая",   "ой",   "ой",   "ую",   "ой",   "ой",   ""],                   // Вершицк-ая
      ["1f",  "а",    "ой",   "ой",   "у",    "ой",   "ой",   "вн"],                 // Анисов-а, Дудкин-а 
      ["1f",  "а",    "ы",    "е",    "у",    "ой",   "е",    "бдзт"],               // Шкраб-а, Шалабод-а, Лемез-а, Шабет-а

      // Имя   
      ["2m",  "ев",   "ьва",  "ьву",  "ьва",  "ьвом", "ьве",  ""],                   // Л-ев    
      ["2m",  "ел",   "ла",   "лу",   "ла",   "лом",  "ле",   ""],                   // Пав-ел    
      ["2m",  "а",    "ы",    "е",    "у",    "ой",   "е",    ""],                   // Никит-а   
      ["2m",  "й",    "я",    "ю",    "я",    "ем",   "е",    ""],                   // Никола-й   
      ["2m",  "ь",    "я",    "ю",    "я",    "ем",   "е",    ""],                   // Игор-ь   
      ["2m",  "я",    "и",    "е",    "ю",    "ёй",   "е",    ""],                   // Иль-я   
      ["2m",  "",     "а",    "у",    "а",    "ом",   "е",    "вгджзклмнпрстфхчцш"], // Михаил   

      ["2f",  "ия",   "ии",   "ии",   "ию",   "ией",  "ии",   ""],                   // Мар-ия   
      ["2f",  "ья",   "ьи",   "ье",   "ью",   "ьей",  "ье",   ""],                   // Натал-ья   
      ["2f",  "ь",    "и",    "и",    "ь",    "ью",   "и",    ""],                   // Любов-ь   
      ["2f",  "а",    "и",    "е",    "у",    "ой",   "е",    "г"],                  // Ольг-а   
      ["2f",  "а",    "ы",    "е",    "у",    "ой",   "е",    ""],                   // Марин-а   
      
      // Отчество   
      ["3m",  "ий",   "его",  "ему",  "его",  "им",   "ем",   "жчшщн"],              // Утренн-ий, хорош-ий
      ["3m",  "ий",   "ого",  "ому",  "ого",  "им",   "ом",   ""],                   // *ск-ий
      ["3m",  "ый",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Нов-ый
      ["3m",  "ой",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Толст-ой
      ["3m",  "ч",    "ча",   "чу",   "ча",   "чем",  "че",   ""],                   // Степанови-ч   
      ["3f",  "ая",   "ой",   "ой",   "ую",   "ой",   "ой",   ""],                   // *н-яя
      ["3f",  "а",    "ы",    "е",    "у",    "ой",   "е",    "н"],                  // Михайловн-а

      // Post (#n / #a)
      ["#n",  "ий",   "его",  "ему",  "его",   "им",  "ем",   ""],                   // Заведующ-ий
      ["#n",  "ие",   "ия",   "ию",   "ия",   "ием",  "ии",   "т"],                  // Предприят-ие
      ["#n",  "й",    "я",    "ю",    "я",    "ем",   "е",    ""],                   // Ма-й
      ["#n",  "ь",    "я",    "ю",    "я",    "ем",   "е",    ""],                   // Секретар-ь
      ["#n",  "",     "а",    "у",    "а",    "ом",   "е",    "крт"],                // Электрик, Директор
      
      ["#a",  "ый",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Генеральн-ый
      ["#a",  "ое",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Унитарн-ое

      // Общие (подразделение, учреждение, …) — С / П
      ["a",   "ый",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Финансовый
      ["a",   "ий",   "ого",  "ому",  "ого",  "им",   "ом",   ""],                   // Юридический
      ["a",   "ое",   "ого",  "ому",  "ого",  "ым",   "ом",   ""],                   // Образовательное
      ["a",   "ая",   "ой",   "ой",   "ую",   "ой",   "ой",   ""],                   // Научная

      ["n",   "ость", "ости", "ости", "ость", "остью","ости", ""],                   // Безопасность
      ["n",   "ия",   "ии",   "ии",   "ию",   "ией",  "ии",   ""],                   // Администрация, Бухгалтерия
      ["n",   "ие",   "ия",   "ию",   "ие",   "ием",  "ии",   ""],                   // Учреждение, Управление
      ["n",   "а",    "и",    "е",    "у",    "ой",   "е",    "кгшжх"],              // Книга → книги
      ["n",   "а",    "ы",    "е",    "у",    "ой",   "е",    ""],                   // Кафедра, Служба, Группа
      ["n",   "ы",    "ов",   "ам",   "ы",    "ами",  "ах",   ""],                   // Финансы
      ["n",   "й",    "я",    "ю",    "й",    "ем",   "е",    ""],                   // Музей
      ["n",   "ь",    "я",    "ю",    "ь",    "ем",   "е",    ""],                   // Словарь
      ["n",   "",     "а",    "у",    "а",    "ом",   "е",    "бвгджзклмнпрстфхцчшщ"], // Отдел, Факультет, Институт
    ];
  }
}

__wordCaser = new WordCaserEngineRu();
